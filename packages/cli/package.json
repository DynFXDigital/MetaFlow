{
  "name": "@metaflow/cli",
  "description": "CLI for layered AI metadata overlays for Copilot instructions, prompts, skills, and agents.",
  "version": "0.2.0",
  "license": "MIT",
  "private": true,
  "bin": {
    "metaflow": "out/src/cli.js"
  },
  "main": "out/src/cli.js",
  "types": "out/src/cli.d.ts",
  "scripts": {
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "clean": "rimraf out",
    "pretest": "npm run build",
    "test": "mocha \"out/test/**/*.test.js\" --timeout 10000",
    "test:coverage": "npm run build && node ../../scripts/coverage.mjs --tests \"out/test/**/*.test.js\" --include \"out/src/**\""
  },
  "dependencies": {
    "@metaflow/engine": "file:../engine",
    "commander": "^14.0.3",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^25.9.2",
    "c8": "^11.0.0",
    "mocha": "^11.7.5",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  }
}
