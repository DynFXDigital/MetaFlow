{
  "name": "@metaflow/engine",
  "description": "Engine for layered AI metadata overlays for Copilot instructions, prompts, skills, and agents.",
  "version": "0.3.6",
  "license": "MIT",
  "private": true,
  "main": "out/src/index.js",
  "types": "out/src/index.d.ts",
  "scripts": {
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "clean": "rimraf out",
    "pretest": "npm run clean && npm run build",
    "test": "mocha \"out/test/**/*.test.js\" --timeout 10000",
    "test:coverage": "npm run build && node ../../scripts/coverage.mjs --tests \"out/test/**/*.test.js\" --include \"out/src/**\""
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "minimatch": "^10.2.4"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^26.1.1",
    "c8": "^12.0.0",
    "mocha": "^11.7.5",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}
