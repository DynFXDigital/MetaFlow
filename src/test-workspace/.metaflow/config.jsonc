{
  "compatibilityVersion": 2,
  "metadataRepos": [
    {
      "id": "primary",
      "localPath": ".ai/ai-metadata",
      "enabled": true,
      "capabilities": [
        {
          "path": "company/core",
          "enabled": false
        },
        {
          "path": "standards/sdlc",
          "enabled": false
        }
      ]
    }
  ],
  "filters": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "profiles": {
    "default": {
      "displayName": "Default",
      "enable": [
        "**/*"
      ]
    },
    "review": {
      "displayName": "Review",
      "enable": [
        "**/*"
      ]
    }
  },
  "activeProfile": "default"
}