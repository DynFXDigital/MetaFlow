{
  "metadataRepos": [
    {
      "id": "primary",
      "localPath": ".ai/ai-metadata",
      "capabilities": [
        {
          "path": "company/core",
          "enabled": false
        },
        {
          "path": "standards/sdlc",
          "enabled": true
        }
      ]
    }
  ],
  "profiles": {
    "default": {
      "displayName": "Default",
      "enable": [
        "**/*"
      ]
    },
    "review": {
      "displayName": "Review",
      "enable": [
        "**/*"
      ]
    }
  },
  "activeProfile": "default",
  "compatibilityVersion": 2
}